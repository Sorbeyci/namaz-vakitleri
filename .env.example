# Diyanet namaz vakitleri API anahtari (zorunlu, yalnizca sunucu tarafinda kullanilir)
# Vercel'de: Project Settings -> Environment Variables -> DIYANET_API_KEY
DIYANET_API_KEY=

# Istege bagli: Firestore'da kalici sunucu cache'i icin Firebase service account JSON'u
# (Firebase Console -> Project Settings -> Service accounts -> Generate new private key)
# JSON'un tamamini tek satir olarak yapistirin. Bos birakilirsa bellek-ici cache kullanilir.
FIREBASE_SERVICE_ACCOUNT=
