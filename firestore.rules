rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Namaz vakitleri cache'i yalnizca sunucu (Admin SDK) tarafindan kullanilir
    match /prayerTimesCache/{city} {
      allow read, write: if false;
    }

    // Kullanici yalnizca kendi verisine erisebilir
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /days/{day} {
        allow read, delete: if request.auth != null && request.auth.uid == uid;
        allow create, update: if request.auth != null
          && request.auth.uid == uid
          // tarih anahtari YYYY-MM-DD bicimli olmali
          && day.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}');
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
